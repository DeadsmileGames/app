{
  "expo": {
    "name": "Deadsmile Games",
    "slug": "deadsmile-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "deadsmile",
    "userInterfaceStyle": "dark",
    "android": {
      "versionCode": 2,
      "package": "com.deadsmile.games",
      "adaptiveIcon": {
        "backgroundColor": "#f80202",
        "foregroundImage": "./assets/branding/icons/icon.png",
        "monochromeImage": "./assets/branding/icons/mono.png"
      }
    },
    "ios": {
      "buildNumber": "2"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/branding/icons/notification.png",
          "color": "#f80202",
          "defaultChannel": "publications"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f80202",
          "image": "./assets/branding/icons/splash.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a176259e-0a34-4e97-876b-648a315b6835"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a176259e-0a34-4e97-876b-648a315b6835"
    }
  }
}
